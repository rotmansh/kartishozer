# Copy to .env for local development (never commit the real .env file).
#
# ── Database (required) ─────────────────────────────────────────
# On Vercel: add the "Postgres" storage integration to the project and
# it injects POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING automatically —
# just point these two at those.
DATABASE_URL="postgresql://user:password@localhost:5432/kartishozer_dev?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/kartishozer_dev?schema=public"

# ── Auth (optional locally — the app degrades gracefully without it) ──
# Without these two set, every page still builds and runs, but sign-in/
# sign-up show a "not configured" placeholder and every auth-gated action
# returns "please sign in" instead of working. Get real values from
# https://dashboard.clerk.com after creating an application there.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# For /admin access: in the Clerk dashboard, set a user's
# publicMetadata to {"role": "ADMIN"}, and under Sessions > Customize
# session token, add a "metadata" claim mapped to {{user.public_metadata}}
# so requireAdminUser() can read it.

# ── New-message notifications (both optional — without them the app
# still works, buyers/sellers just have to open /messages themselves) ──

# Email: create a free account at https://resend.com, get an API key from
# the dashboard. EMAIL_FROM can stay as the default resend.dev sandbox
# sender until a real domain is verified on Resend.
RESEND_API_KEY=""
EMAIL_FROM="כרטיס חוזר <onboarding@resend.dev>"

# Web push: a VAPID key pair, generated once and reused forever (not tied
# to any account/service — `npx web-push generate-vapid-keys` or the
# `web-push` npm package's generateVAPIDKeys()). The public key is safe to
# expose to the browser; the private key must stay secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
