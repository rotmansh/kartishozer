// ============================================================
// KartisHozer — Phase 2 schema
// Money is always stored in agorot (1 ILS = 100 agorot).
// Field/relation names intentionally match what the existing
// admin panel code (kartishozer-admin-panel) already expects,
// so that panel can be wired to this same database.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Users & vendors ─────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  fullName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor       Vendor?
  orders       Order[]
  favorites    Favorite[]
  disputesMade Dispute[] @relation("DisputeRequestedBy")

  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  sentMessages          Message[]
  eventFavorites        EventFavorite[]
  pushSubscriptions     PushSubscription[]
}

enum VerificationLevel {
  NONE
  BASIC
  FULL
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
}

model Vendor {
  id                 String            @id @default(cuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id])
  displayName        String
  isVerified         Boolean           @default(false)
  verificationLevel  VerificationLevel @default(NONE)
  status             VendorStatus      @default(ACTIVE)
  bankAccountRef     String?
  createdAt          DateTime          @default(now())

  listings  Listing[]
  orders    Order[]
  payouts   Payout[]

  @@index([status])
}

// ── Catalog ───────────────────────────────────────────────────

enum CategorySlug {
  concerts
  standup
  theater
  sports
  attractions
  vouchers
}

model Venue {
  id     String  @id @default(cuid())
  nameHe String
  city   String

  events Event[]

  @@unique([nameHe, city])
}

model Event {
  id            String       @id @default(cuid())
  nameHe        String
  category      CategorySlug
  venueId       String
  venue         Venue        @relation(fields: [venueId], references: [id])
  startsAt      DateTime
  // True for tickets not tied to a specific showtime (a theme park, a
  // museum) — startsAt is then a fixed far-future sentinel rather than a
  // real date, purely so multiple sellers listing the same open-date
  // attraction collide on the existing @@unique below and land on one
  // Event instead of fragmenting across rows keyed by whatever arbitrary
  // date each seller happened to type in.
  isOpenDate    Boolean      @default(false)
  descriptionHe String
  gradientFrom  String
  gradientTo    String
  emoji         String
  createdAt     DateTime     @default(now())

  listings Listing[]
  orders   Order[]
  favoritedBy EventFavorite[]

  @@unique([nameHe, venueId, startsAt])
  @@index([category])
  @@index([startsAt])
}

// Saving interest in an event/attraction itself — distinct from Favorite
// (below), which saves a specific seller's listing. A buyer often wants
// to bookmark a show before any tickets they like are even listed yet.
model EventFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

// ── Listings & risk ───────────────────────────────────────────

enum ListingStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
  SOLD
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

model Listing {
  id                 String        @id @default(cuid())
  eventId            String
  event              Event         @relation(fields: [eventId], references: [id])
  vendorId           String
  vendor             Vendor        @relation(fields: [vendorId], references: [id])
  status             ListingStatus @default(PENDING_REVIEW)
  section            String?
  quantity           Int
  priceAgorot        Int
  faceValueAgorot    Int
  isSafePassExchange Boolean       @default(true)
  note               String?
  riskScore          Int           @default(0)
  riskLevel          RiskLevel     @default(LOW)
  createdAt          DateTime      @default(now())
  deletedAt          DateTime?

  riskAssessment ListingRisk?
  orders         Order[]
  favorites      Favorite[]

  @@index([status])
  @@index([eventId])
  @@index([vendorId])
  @@index([riskLevel])
}

model ListingRisk {
  id                  String    @id @default(cuid())
  listingId           String    @unique
  listing             Listing   @relation(fields: [listingId], references: [id])
  decision            String? // APPROVE | REJECT | REQUEST_INFO
  totalScore          Int       @default(0)
  duplicateBarcode    Boolean   @default(false)
  duplicatePdfHash    Boolean   @default(false)
  suspiciousFaceValue Boolean   @default(false)
  highRiskAccount     Boolean   @default(false)
  bulkListingFlag     Boolean   @default(false)
  reviewedById        String?
  reviewedAt          DateTime?
  reviewNotes         String?
}

// ── Orders ────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  TICKET_DELIVERED
  DISPUTED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

model Order {
  id               String      @id @default(cuid())
  listingId        String
  listing          Listing     @relation(fields: [listingId], references: [id])
  eventId          String
  event            Event       @relation(fields: [eventId], references: [id])
  buyerId          String
  buyer            User        @relation(fields: [buyerId], references: [id])
  vendorId         String
  vendor           Vendor      @relation(fields: [vendorId], references: [id])
  quantity         Int
  priceAgorot      Int
  buyerFeeAgorot   Int
  totalAgorot      Int
  status           OrderStatus @default(PENDING)
  buyerName        String
  buyerEmail       String
  providerIntentId String?
  paidAt           DateTime?
  createdAt        DateTime    @default(now())

  disputes      Dispute[]
  payouts       Payout[]
  ledgerEntries LedgerEntry[]
  conversation  Conversation?

  @@index([status])
  @@index([buyerId])
  @@index([vendorId])
}

// One conversation per order — this is delivery-coordination for that
// specific ticket, not a general inbox. Keeps the model simple (no
// group chats, no unsolicited messaging) and means every thread already
// carries its own context (which event, which order) with nothing extra
// to wire up.
model Conversation {
  id               String    @id @default(cuid())
  orderId          String    @unique
  order            Order     @relation(fields: [orderId], references: [id])
  buyerId          String
  buyer            User      @relation("ConversationBuyer", fields: [buyerId], references: [id])
  sellerId         String
  seller           User      @relation("ConversationSeller", fields: [sellerId], references: [id])
  messages         Message[]
  // Null means "never opened this conversation" — distinct from having
  // read it at some specific past time, so a brand-new thread with a
  // message already in it still counts as unread.
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// One row per browser/device the user granted notification permission on
// (a phone and a laptop both get their own row) — the Push API's
// endpoint URL is what a server later POSTs to to trigger a notification.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Disputes ──────────────────────────────────────────────────

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
}

model Dispute {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  type          String
  reason        String
  status        DisputeStatus @default(OPEN)
  requestedById String
  requestedBy   User          @relation("DisputeRequestedBy", fields: [requestedById], references: [id])
  resolution    String?
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@index([status])
}

// ── Payouts ───────────────────────────────────────────────────

enum PayoutStatus {
  PENDING
  PROCESSING
  ON_HOLD
  PAID
  FAILED
}

enum PayoutTrigger {
  AUTO
  MANUAL
}

model Payout {
  id            String        @id @default(cuid())
  vendorId      String
  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  amountAgorot  Int
  status        PayoutStatus  @default(PENDING)
  trigger       PayoutTrigger @default(AUTO)
  scheduledFor  DateTime?
  processedAt   DateTime?
  failureReason String?
  createdAt     DateTime      @default(now())

  @@index([status])
}

// ── Ledger (double-entry bookkeeping, agorot) ──────────────────

enum LedgerEntryType {
  PLATFORM_FEE_BUYER
  SELLER_PROCEEDS
  REFUND_BUYER
}

model LedgerEntry {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  type           LedgerEntryType
  amountAgorot   Int
  debitAccount   String
  creditAccount  String
  createdAt      DateTime        @default(now())
}

// ── Favorites ─────────────────────────────────────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

// ── Platform config & audit ────────────────────────────────────

model PlatformConfig {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  resourceType String
  resourceId   String
  userId       String // real User.id, or "system" — not a FK, so log rows outlive deleted users
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([createdAt])
}
