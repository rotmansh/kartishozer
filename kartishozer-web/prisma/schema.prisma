// ============================================================
// KartisHozer — Phase 2 schema
// Money is always stored in agorot (1 ILS = 100 agorot).
// Field/relation names intentionally match what the existing
// admin panel code (kartishozer-admin-panel) already expects,
// so that panel can be wired to this same database.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Users & vendors ─────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  fullName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor       Vendor?
  orders       Order[]
  favorites    Favorite[]
  disputesMade Dispute[] @relation("DisputeRequestedBy")

  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  sentMessages          Message[]
  eventFavorites        EventFavorite[]
  pushSubscriptions     PushSubscription[]
  disputeEvidenceUploads DisputeEvidence[]
}

enum VerificationLevel {
  NONE
  BASIC
  FULL
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
}

model Vendor {
  id                 String            @id @default(cuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id])
  displayName        String
  isVerified         Boolean           @default(false)
  // Every vendor reaching this row already completed Clerk's own signup
  // verification (email always, phone when they added one) before they
  // could create anything at all — so BASIC, not NONE, is the true
  // starting state. FULL is reached either by an admin's manual VERIFY
  // action or automatically once assessListingRisk's trustedSellerCredit
  // criteria are met (see listings.actions.ts) — real KYC (government-ID
  // verification) is a deliberate, not-yet-built follow-up on top of FULL.
  verificationLevel  VerificationLevel @default(BASIC)
  status             VendorStatus      @default(ACTIVE)
  bankAccountRef     String?
  createdAt          DateTime          @default(now())

  listings              Listing[]
  orders                Order[]
  payouts               Payout[]
  riskAssessmentHistory RiskAssessmentEvent[]

  @@index([status])
}

// ── Catalog ───────────────────────────────────────────────────

enum CategorySlug {
  concerts
  standup
  theater
  sports
  attractions
  vouchers
}

model Venue {
  id     String  @id @default(cuid())
  nameHe String
  city   String

  events Event[]

  @@unique([nameHe, city])
}

model Event {
  id            String       @id @default(cuid())
  nameHe        String
  category      CategorySlug
  venueId       String
  venue         Venue        @relation(fields: [venueId], references: [id])
  startsAt      DateTime
  // True for tickets not tied to a specific showtime (a theme park, a
  // museum) — startsAt is then a fixed far-future sentinel rather than a
  // real date, purely so multiple sellers listing the same open-date
  // attraction collide on the existing @@unique below and land on one
  // Event instead of fragmenting across rows keyed by whatever arbitrary
  // date each seller happened to type in.
  isOpenDate    Boolean      @default(false)
  descriptionHe String
  gradientFrom  String
  gradientTo    String
  emoji         String
  createdAt     DateTime     @default(now())

  listings Listing[]
  orders   Order[]
  favoritedBy EventFavorite[]

  @@unique([nameHe, venueId, startsAt])
  @@index([category])
  @@index([startsAt])
}

// Saving interest in an event/attraction itself — distinct from Favorite
// (below), which saves a specific seller's listing. A buyer often wants
// to bookmark a show before any tickets they like are even listed yet.
model EventFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

// ── Listings & risk ───────────────────────────────────────────

enum ListingStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
  SOLD
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

model Listing {
  id                 String        @id @default(cuid())
  eventId            String
  event              Event         @relation(fields: [eventId], references: [id])
  vendorId           String
  vendor             Vendor        @relation(fields: [vendorId], references: [id])
  status             ListingStatus @default(PENDING_REVIEW)
  section            String?
  quantity           Int
  priceAgorot        Int
  faceValueAgorot    Int
  isSafePassExchange Boolean       @default(true)
  // Self-reported by the seller at listing time — whether they'll use the
  // original ticketing provider's own transfer feature (e.g. an account-
  // to-account transfer), when that provider has one. Nothing here
  // verifies this actually happened; there's no integration with any
  // ticketing provider to check against. It's surfaced to buyers as a
  // preferred signal, same spirit as isSafePassExchange above, not a
  // guarantee.
  offersOfficialTransfer Boolean   @default(false)
  note               String?
  riskScore          Int           @default(0)
  riskLevel          RiskLevel     @default(LOW)
  createdAt          DateTime      @default(now())
  deletedAt          DateTime?

  riskAssessment        ListingRisk?
  riskAssessmentHistory RiskAssessmentEvent[]
  orders                Order[]
  favorites             Favorite[]
  ticketFile            TicketFile?

  @@index([status])
  @@index([eventId])
  @@index([vendorId])
  @@index([riskLevel])
}

// The seller's actual ticket file, held in a digital vault: never linked
// to from anywhere a buyer can reach before they've paid (see
// /api/tickets/[listingId], the only thing that ever reads storageUrl).
// sha256 is the exact-file duplicate check — the same bytes uploaded again
// under a different listing (even a different vendor) is strong fraud
// evidence on its own. Barcode/QR-based duplicate detection (catching a
// re-encoded or re-photographed copy of the same underlying ticket, not
// just the same file) is a deliberate follow-up, not implemented here.
model TicketFile {
  id            String   @id @default(cuid())
  listingId     String   @unique
  listing       Listing  @relation(fields: [listingId], references: [id])
  storageUrl    String
  mimeType      String
  fileSizeBytes Int
  sha256        String
  uploadedAt    DateTime @default(now())

  @@index([sha256])
}

model ListingRisk {
  id                  String    @id @default(cuid())
  listingId           String    @unique
  listing             Listing   @relation(fields: [listingId], references: [id])
  decision            String? // APPROVE | REJECT | REQUEST_INFO
  // Which version of assessListingRisk (see listings.actions.ts) produced
  // this row — so a future change to the algorithm can never make an old
  // decision look inexplicable. See also RiskAssessmentEvent below, which
  // keeps every past assessment instead of only this current one.
  riskEngineVersion   String    @default("v1")
  totalScore          Int       @default(0)
  duplicateBarcode    Boolean   @default(false)
  duplicatePdfHash    Boolean   @default(false)
  suspiciousFaceValue Boolean   @default(false)
  highRiskAccount     Boolean   @default(false)
  bulkListingFlag     Boolean   @default(false)
  repeatEventFlag     Boolean   @default(false)
  highQuantityFlag    Boolean   @default(false)
  highValueTicketFlag Boolean   @default(false)
  pastDisputeFlag     Boolean   @default(false)
  trustedSellerCredit Boolean   @default(false)
  reviewedById        String?
  reviewedAt          DateTime?
  reviewNotes         String?
}

// Append-only history of every risk assessment ever computed — ListingRisk
// above is a single "current state" row per listing (overwritten on every
// re-assessment), which was silently losing the previous assessment's
// score/flags on every price or quantity edit. This table is never
// updated or deleted, only inserted into, once per assessment, so a past
// decision can always be reconstructed exactly as it was made.
enum RiskAssessmentTrigger {
  LISTING_CREATED
  PRICE_OR_QUANTITY_EDITED
  DUPLICATE_FILE_DETECTED
}

model RiskAssessmentEvent {
  id                  String                @id @default(cuid())
  listingId           String
  listing             Listing               @relation(fields: [listingId], references: [id])
  vendorId            String
  vendor              Vendor                @relation(fields: [vendorId], references: [id])
  riskEngineVersion   String
  trigger             RiskAssessmentTrigger
  totalScore          Int
  riskLevel           RiskLevel
  decision            String
  duplicateBarcode    Boolean
  duplicatePdfHash    Boolean
  suspiciousFaceValue Boolean
  highRiskAccount     Boolean
  bulkListingFlag     Boolean
  repeatEventFlag     Boolean
  highQuantityFlag    Boolean
  highValueTicketFlag Boolean
  pastDisputeFlag     Boolean
  trustedSellerCredit Boolean
  createdAt           DateTime              @default(now())

  @@index([listingId])
  @@index([vendorId])
  @@index([createdAt])
}

// ── Orders ────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  TICKET_DELIVERED
  DISPUTED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

model Order {
  id               String      @id @default(cuid())
  listingId        String
  listing          Listing     @relation(fields: [listingId], references: [id])
  eventId          String
  event            Event       @relation(fields: [eventId], references: [id])
  buyerId          String
  buyer            User        @relation(fields: [buyerId], references: [id])
  vendorId         String
  vendor           Vendor      @relation(fields: [vendorId], references: [id])
  quantity         Int
  priceAgorot      Int
  buyerFeeAgorot   Int
  totalAgorot      Int
  status           OrderStatus @default(PENDING)
  buyerName        String
  buyerEmail       String
  providerIntentId String?
  paidAt           DateTime?
  createdAt        DateTime    @default(now())

  disputes      Dispute[]
  payouts       Payout[]
  ledgerEntries LedgerEntry[]
  paymentEvents PaymentEvent[]
  pricing       OrderPricing?
  conversation  Conversation?

  @@index([status])
  @@index([buyerId])
  @@index([vendorId])
}

// A permanent, self-contained snapshot of exactly which fee rule was
// live when this order was created — Order's own priceAgorot/
// buyerFeeAgorot/totalAgorot keep meaning "what happened", but say
// nothing about *why* (which config values, which pricing engine
// structure). Written once, in the same transaction as the order, and
// never updated afterward: a later refund/dispute changes what actually
// moved (LedgerEntry/PaymentEvent already record that), never what this
// order was originally priced under. A future change to buyer_fee_percent/
// seller_fee_percent, or a new pricing engine version entirely, can
// therefore never alter the recorded meaning of a past transaction.
model OrderPricing {
  id                      String   @id @default(cuid())
  orderId                 String   @unique
  order                   Order    @relation(fields: [orderId], references: [id])
  // The fee-engine RULE STRUCTURE (see src/lib/pricingVersion.ts) — bumped
  // only when the shape of the calculation itself changes (e.g. tiered
  // fees, a promo mechanism), never when an admin just edits a percentage.
  // That per-value history lives in PlatformConfigVersion instead.
  pricingVersion          String
  buyerFeePercent         Float
  sellerFeePercent        Float
  buyerFeeAgorot          Int
  sellerFeeAgorot         Int
  // Always 0 today — no promotional discount/subsidy mechanism exists yet.
  // The column exists so that whenever one is built, every order from
  // that point on carries its own true discount amount rather than this
  // being backfilled or inferred later.
  discountAgorot          Int      @default(0)
  totalPaidByBuyerAgorot  Int
  amountDueToSellerAgorot Int
  platformRevenueAgorot   Int
  createdAt               DateTime @default(now())
}

// Append-only log of every payment/payout lifecycle moment — Order.status
// and Payout.status only ever hold the CURRENT state, so a full history
// (when was it captured, held, released, refunded — not just "it's
// REFUNDED now") didn't exist anywhere before this. "internal" as
// `provider` marks a transition that's our own decision (a dispute
// freezing a payout, an admin holding one) rather than an actual payment-
// gateway call — everything else carries the real provider's name so a
// future non-mock processor slots in without a schema change.
enum PaymentEventType {
  PAYMENT_INITIATED
  PAYMENT_AUTHORIZED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  PAYOUT_SCHEDULED
  PAYOUT_HELD
  PAYOUT_RESUMED
  PAYOUT_PROCESSING_STARTED
  PAYOUT_CANCELLED
  REFUND_INITIATED
  REFUND_COMPLETED
  CHARGEBACK_OPENED
  CHARGEBACK_RESOLVED
}

model PaymentEvent {
  id                String           @id @default(cuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id])
  payoutId          String?
  payout            Payout?          @relation(fields: [payoutId], references: [id])
  type              PaymentEventType
  provider          String
  providerReference String?
  amountAgorot      Int
  currency          String           @default("ILS")
  status            String?
  reason            String?
  createdAt         DateTime         @default(now())

  @@index([orderId])
  @@index([payoutId])
  @@index([type])
  @@index([createdAt])
}

// One conversation per order — this is delivery-coordination for that
// specific ticket, not a general inbox. Keeps the model simple (no
// group chats, no unsolicited messaging) and means every thread already
// carries its own context (which event, which order) with nothing extra
// to wire up.
model Conversation {
  id               String    @id @default(cuid())
  orderId          String    @unique
  order            Order     @relation(fields: [orderId], references: [id])
  buyerId          String
  buyer            User      @relation("ConversationBuyer", fields: [buyerId], references: [id])
  sellerId         String
  seller           User      @relation("ConversationSeller", fields: [sellerId], references: [id])
  messages         Message[]
  // Null means "never opened this conversation" — distinct from having
  // read it at some specific past time, so a brand-new thread with a
  // message already in it still counts as unread.
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// One row per browser/device the user granted notification permission on
// (a phone and a laptop both get their own row) — the Push API's
// endpoint URL is what a server later POSTs to to trigger a notification.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Disputes ──────────────────────────────────────────────────

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
}

model Dispute {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  type          String
  reason        String
  status        DisputeStatus @default(OPEN)
  requestedById String
  requestedBy   User          @relation("DisputeRequestedBy", fields: [requestedById], references: [id])
  // The seller previously had no way to answer a dispute at all — only
  // the buyer's initial reason and the admin's eventual resolution were
  // ever recorded. One response per dispute is enough for what this
  // needs to be right now (collecting both sides' account of what
  // happened for whenever dispute-handling rules get defined with a
  // lawyer), not a back-and-forth thread.
  sellerResponse    String?
  sellerRespondedAt DateTime?
  resolution    String?
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())

  evidence DisputeEvidence[]

  @@index([status])
}

enum DisputeEvidenceUploader {
  BUYER
  SELLER
  ADMIN
}

// Photos/documents either side attaches to back up their account — held
// in the same kind of private storage as ticket files (never a public
// URL), served only through /api/disputes/[disputeId]/evidence/
// [evidenceId] to the dispute's own buyer/seller or an admin.
model DisputeEvidence {
  id            String                  @id @default(cuid())
  disputeId     String
  dispute       Dispute                 @relation(fields: [disputeId], references: [id])
  uploadedById  String
  uploadedBy    User                    @relation(fields: [uploadedById], references: [id])
  uploaderRole  DisputeEvidenceUploader
  storageUrl    String
  mimeType      String
  fileSizeBytes Int
  note          String?
  createdAt     DateTime                @default(now())

  @@index([disputeId])
}

// ── Payouts ───────────────────────────────────────────────────

enum PayoutStatus {
  PENDING
  PROCESSING
  ON_HOLD
  PAID
  FAILED
}

enum PayoutTrigger {
  AUTO
  MANUAL
}

model Payout {
  id            String        @id @default(cuid())
  vendorId      String
  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  amountAgorot  Int
  status        PayoutStatus  @default(PENDING)
  trigger       PayoutTrigger @default(AUTO)
  scheduledFor  DateTime?
  processedAt   DateTime?
  failureReason String?
  createdAt     DateTime      @default(now())

  paymentEvents PaymentEvent[]

  @@index([status])
}

// ── Ledger (double-entry bookkeeping, agorot) ──────────────────

enum LedgerEntryType {
  PLATFORM_FEE_BUYER
  // The seller's fee was always subtracted when computing SELLER_PROCEEDS
  // below (see createOrderAction), so the money was never wrong — but that
  // fee had no ledger line of its own, so total platform revenue could
  // only ever be reconstructed correctly from PLATFORM_FEE_BUYER, silently
  // missing this half of every order's take. Additive: existing entries
  // and the SELLER_PROCEEDS amount are unchanged.
  PLATFORM_FEE_SELLER
  SELLER_PROCEEDS
  REFUND_BUYER
}

model LedgerEntry {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  type           LedgerEntryType
  amountAgorot   Int
  debitAccount   String
  creditAccount  String
  createdAt      DateTime        @default(now())
}

// ── Favorites ─────────────────────────────────────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

// ── Platform config & audit ────────────────────────────────────

model PlatformConfig {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// Append-only history of every PlatformConfig change — PlatformConfig
// itself keeps holding only the CURRENT value per key, exactly as
// before; this is the equivalent of RiskAssessmentEvent/PaymentEvent for
// business configuration, so "what was buyer_fee_percent on date X" (or
// payout_delay_days, a risk threshold, etc.) can always be answered
// precisely. `version` is a per-key sequence (buyer_fee_percent's own
// v1, v2, v3…), not a global one. Only ever inserted from
// updatePlatformConfigAction going forward — never backfilled for
// changes made before this table existed, since that history was never
// captured and never will be invented.
model PlatformConfigVersion {
  id            String   @id @default(cuid())
  key           String
  version       Int
  previousValue String?
  newValue      String
  // Real User.id, or "system" — not a FK, same convention as
  // AuditLog.userId, so this table never breaks if that admin's account
  // is ever removed.
  changedById   String
  effectiveFrom DateTime @default(now())
  changedAt     DateTime @default(now())

  @@unique([key, version])
  @@index([key, effectiveFrom])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  resourceType String
  resourceId   String
  userId       String // real User.id, or "system" — not a FK, so log rows outlive deleted users
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ── Analytics: visitors, attribution, business-event funnel ────
// P2 of the data-retention/analytics requirements. Deliberately narrow:
// business events meaningful enough to reconstruct a funnel step or a
// listing's view/conversion numbers later, never every click. Nothing
// here is a mutable counter — a listing's "views" and "unique viewers"
// are always computed by querying AnalyticsEvent, so the source data
// survives even if the definition of "unique" changes later.

// One row per anonymous browser, identified by a long-lived, random,
// httpOnly cookie (`kh_vid` — see src/lib/analytics.ts) that carries no
// information about the device itself (no IP/user-agent/canvas
// fingerprinting of any kind). Exists purely so a pre-signup funnel
// (visitor -> signup) and acquisition attribution can be reconstructed;
// once the visitor signs up, `userId` links this row to their real
// account (see linkVisitorToUser) for the rest of that browser's life.
model Visitor {
  id     String  @id
  // Not a `@relation` on purpose, same convention as AuditLog.userId —
  // this table must never be blocked by, or accidentally cascade from,
  // changes to User. Deliberately NOT unique: one User can (and normally
  // does) have several Visitor rows — one per browser/device — once
  // signed in on each. User-level metrics must dedupe by userId, not by
  // visitorId, precisely because of this (see getActiveIdentityCount in
  // src/lib/analytics.ts). Never used to infer identity before sign-in —
  // linking only ever happens via an authenticated session
  // (linkVisitorToUser), never fingerprinting.
  userId String?

  firstTouchAt     DateTime @default(now())
  firstUtmSource   String?
  firstUtmMedium   String?
  firstUtmCampaign String?
  firstUtmContent  String?
  firstUtmTerm     String?
  firstReferrer    String?
  firstLandingPath String?

  // Updated only when a later visit actually carries new attribution (a
  // fresh utm_* param, or a referrer from outside the site) — a plain
  // same-site navigation never overwrites this, so it stays meaningful as
  // "the last real marketing touch", not "whatever page they looked at
  // most recently".
  lastTouchAt      DateTime @default(now())
  lastUtmSource    String?
  lastUtmMedium    String?
  lastUtmCampaign  String?
  lastUtmContent   String?
  lastUtmTerm      String?
  lastReferrer     String?
  lastLandingPath  String?

  @@index([userId])
}

enum AnalyticsEventType {
  // Fired once per browser tab session (not every page) — the backbone
  // for DAU/WAU/MAU and general traffic, independent of whether that
  // visit happened to touch any specific funnel step below.
  SITE_VISIT
  LISTING_VIEWED
  FAVORITE_ADDED
  FAVORITE_REMOVED
  CHECKOUT_STARTED
  PAYMENT_STARTED
  PAYMENT_FAILED
  SELL_WIZARD_STARTED
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  // None of these four are `@relation` — same reasoning as AuditLog: an
  // ever-growing append-only log must never be coupled to the lifecycle
  // of the rows it references, and a soft-deleted/renamed listing must
  // never make a past event unreadable.
  visitorId String?
  userId    String?
  listingId String?
  eventId   String?
  orderId   String?
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([listingId, type])
  @@index([type, createdAt])
  @@index([userId])
  @@index([visitorId])
  @@index([orderId])
}

// ── Rate limiting ─────────────────────────────────────────────
// A minimal sliding-window limiter backed by Postgres (no new external
// service to set up) — see src/lib/rateLimit.ts. One row per attempt,
// `key` already encodes both the action and the identity being limited
// (e.g. "createOrder:<userId>", "recordVisit:<ip>"). Rows are pruned
// opportunistically by the same helper, so this table never grows
// unbounded even without a dedicated cleanup job.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
